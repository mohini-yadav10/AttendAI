# ============================================================
# AttendAI — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# ============================================================

# ── Node Environment ────────────────────────────────────────
NODE_ENV=development

# ── Backend Server ──────────────────────────────────────────
PORT=5000
BACKEND_URL=http://localhost:5000

# ── Database ────────────────────────────────────────────────
# Local MongoDB (default for development)
MONGODB_URI=mongodb://localhost:27017/attendai

# MongoDB Atlas (optional — uncomment and set for cloud deployment)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/attendai?retryWrites=true&w=majority

# ── Authentication ──────────────────────────────────────────
# Generate a strong random string: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI Service ──────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Set to "true" to use mock AI responses (no Python service required)
AI_MOCK_MODE=true

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_AI_MOCK_MODE=true

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
