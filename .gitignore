# ============================================================
# AttendAI — .gitignore
# ============================================================

# ── Secrets & Environment ───────────────────────────────────
.env
.env.local
.env.*.local
*.secret
*.pem
*.key
*.p12
*.pfx

# ── Node / npm ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
lerna-debug.log*
.npm
.yarn/

# ── Build Output ────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.vite/
*.tsbuildinfo

# ── TypeScript ──────────────────────────────────────────────
*.js.map
*.d.ts.map

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
reports/
ai-service/reports/
env/
ENV/
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# ── AI / ML models ──────────────────────────────────────────
# Large model weights — do NOT commit
*.pt
*.pth
*.onnx
*.pb
*.h5
*.weights
*.caffemodel
*.prototxt
models/weights/

# ── Uploaded images / biometric data ────────────────────────
uploads/
ai-service/uploads/
backend/uploads/
*.face
*.biometric
reference_images/
captured_frames/

# ── Database ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── OS & Editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.suo
*.user
*.swp
*.swo
*~

# ── Testing ─────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ────────────────────────────────────────────────────
.cache/
tmp/
temp/
